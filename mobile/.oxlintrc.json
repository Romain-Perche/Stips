// Étend le socle racine (../.oxlintrc.json) : plugins + rules-of-hooks.
// Volontairement sans only-export-components (contrairement à frontend) :
// App.tsx exporte `envelopper(App)` (Sentry.wrap), que la règle voit comme
// un composant anonyme, et déclare ses sous-composants dans le même fichier.
// Les écrans, eux, la passent. Si App.tsx est découpé, réévaluer.
{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"]
}
