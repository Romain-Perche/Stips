# Postgres géré par Supabase (région UE). Onglet Settings → Database du projet.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:5432/postgres

# Onglet Settings → API du projet Supabase. La clé secrète (sb_secret_…) ne
# quitte jamais ce serveur.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SECRET_KEY=

# Signe le cookie de session et les jetons des liens de validation.
# 32 caractères minimum : openssl rand -base64 32
SECRET=

# Le site, sans barre oblique finale : les liens des e-mails s'y accrochent.
# http://localhost:5173 en local, https://stips.club en production.
SITE_URL=http://localhost:5173

# Reçoit chaque demande à valider, avec ses deux liens (valider / refuser).
ADMIN_EMAIL=

# Scaleway TEM, application IAM propre au backend (pas celle de supabase-auth).
# Facultatif en local : sans clé, les e-mails s'écrivent dans la console.
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
EXPEDITEUR=bonjour@mail.stips.club

# Fastify. Railway impose le port en production, 3000 en local.
PORT=3000
