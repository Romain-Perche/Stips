{
  "compilerOptions": {
    "target": "es2023",
    // DOM pour le seul type de `fetch` : le client tourne dans le navigateur
    // et sur Hermes, qui en exposent tous deux un compatible. C'est ce qui
    // sépare ce paquet de packages/core, qui reste sans I/O.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
